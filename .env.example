# Copy file ini jadi `.env` (di folder yang sama) lalu isi/sesuaikan nilainya.
# CATATAN: checker ini reuse LICENSE_DEVICE_TOKEN yang sama dengan searchhost utama
# (telegram_login) -- kalau dijalankan di PC yang sama dan .env root searchhost sudah
# terisi, bagian lisensi di bawah TIDAK WAJIB diisi ulang (checker otomatis membaca
# ../.env). Isi kalau mau override lokal / dijalankan berdiri sendiri.

# ---------- License-check ----------
LICENSE_CHECK_URL=https://example.com/monday/searchhost/lisensi-server/api/license-check
LICENSE_DEVICE_TOKEN=<token-device-dari-admin>
LICENSE_CHECK_TIMEOUT_SECONDS=5

# ---------- Remote bucket (opsional) ----------
# Kalau diisi, checker auto-klaim 1 file target dari bucket API begitu folder
# parsed_data/auto/ kosong, lalu hapus dari bucket setelah selesai diproses.
# Kosongkan buat tetap pakai watch-folder lokal saja seperti biasa.
CHECKER_REMOTE_FILES_BASE_URL=https://api.lpmterkam.org/api/files.php
CHECKER_REMOTE_FILES_API_KEY=<key-bucket>

# ---------- Sistem API Skema & Data (SANGAT DISARANKAN diisi) ----------
# BEDA dari bucket di atas (file .txt utuh) -- ini buat kirim tiap baris
# hasil deteksi REALTIME ke 2 skema terpisah, masing-masing API key sendiri.
# TIDAK ADA folder SS/SSIAPA/data.txt lokal -- checker paperless, kosongkan
# salah satu/keduanya berarti baris skema itu TIDAK TERSIMPAN DI MANA PUN.
SCHEMA_DATA_BASE_URL=https://api.lpmterkam.org
SCHEMA_DATA_API_KEY_SS=<key-skema-SS>
SCHEMA_DATA_API_KEY_SSIAPA=<key-skema-SSIAPA>

# ---------- Skema HOSTING: daftar URL WHMCS (SANGAT DISARANKAN diisi) ----------
# Skema TERPISAH (1 kolom: url) di Sistem API yang sama -- tiap URL WHMCS
# baru dikirim ke sini (permanen, boleh dibaca berulang oleh banyak device
# lain, mis. contoh-example/). TIDAK ADA list-hosting.txt lokal -- kosongkan
# berarti URL yang ditemukan TIDAK TERSIMPAN DI MANA PUN.
SCHEMA_DATA_API_KEY_HOSTING=<key-skema-HOSTING>

# ---------- Skema BANNED: banned-hosting.txt dari API (opsional) ----------
# Skema TERPISAH (1 kolom: domain) -- checker READ-ONLY sync dari sini
# (GET, tidak pernah menulis), digabung dengan banned-hosting.txt lokal,
# di-refresh ulang tiap 15 menit selama checker jalan. Kosongkan buat skip.
SCHEMA_DATA_API_KEY_BANNED=<key-skema-BANNED>
