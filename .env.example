# Copy file ini jadi `.env` (di folder yang sama) lalu isi/sesuaikan nilainya.
# CATATAN: checker ini reuse LICENSE_DEVICE_TOKEN yang sama dengan searchhost utama
# (telegram_login) -- kalau dijalankan di PC yang sama dan .env root searchhost sudah
# terisi, bagian lisensi di bawah TIDAK WAJIB diisi ulang (checker otomatis membaca
# ../.env). Isi kalau mau override lokal / dijalankan berdiri sendiri.

# ---------- License-check ----------
LICENSE_CHECK_URL=
LICENSE_DEVICE_TOKEN=
LICENSE_CHECK_TIMEOUT_SECONDS=5
